{
  "expo": {
    "name": "Kaizen Finance",
    "slug": "finance-app",
    "scheme": "finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/finance-app-logo.png",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11231E",
        "foregroundImage": "./assets/finance-app-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kaizen.finance.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/finance-app-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.configure-kaizen-finance"
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kaizen Finance to attach receipt and document images to transactions.",
          "cameraPermission": "Allow Kaizen Finance to take photos for transaction attachments.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/finance-app-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#11231E"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "fil",
              "es"
            ],
            "android": [
              "en",
              "fil",
              "es"
            ]
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Kaizen Finance to use Face ID to unlock your account."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/finance-app-logo.png",
          "color": "#11231E"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickExpenseWidget",
              "label": "Quick Expense",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Quickly record an expense transaction in Kaizen Finance",
              "previewImage": "./assets/quick-expense-widget-preview.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "QuickIncomeWidget",
              "label": "Quick Income",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Quickly record an income transaction in Kaizen Finance",
              "previewImage": "./assets/quick-income-widget-preview.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "QuickTransferWidget",
              "label": "Quick Transfer",
              "minWidth": "60dp",
              "minHeight": "60dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "description": "Quickly record a transfer transaction in Kaizen Finance",
              "previewImage": "./assets/quick-transfer-widget-preview.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            },
            {
              "name": "DualActionWidget",
              "label": "Expense & Income",
              "minWidth": "130dp",
              "minHeight": "60dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "description": "Quick action buttons to record Expense or Income",
              "previewImage": "./assets/dual-action-widget-preview.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "TripleActionWidget",
              "label": "Expense, Income & Transfer",
              "minWidth": "180dp",
              "minHeight": "60dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "maxResizeWidth": "320dp",
              "description": "Quick action bar for Expense, Income, and Transfer",
              "previewImage": "./assets/triple-action-widget-preview.png",
              "resizeMode": "horizontal",
              "updatePeriodMillis": 0
            },
            {
              "name": "MonthlyCashflowWidget",
              "label": "Monthly Cashflow",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Track monthly income, expenses, and net cashflow at a glance",
              "previewImage": "./assets/monthly-cashflow-widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "NetWorthWidget",
              "label": "Net Worth Glance",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Glance at your total net worth and asset breakdown",
              "previewImage": "./assets/net-worth-widget-preview.png",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ]
  }
}
