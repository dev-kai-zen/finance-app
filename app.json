{
  "expo": {
    "name": "Kaizen Finance",
    "slug": "finance-app",
    "scheme": "finance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/finance-app-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11231E",
        "foregroundImage": "./assets/finance-app-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.financeapp.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/finance-app-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ]
  }
}
