# Public OAuth client identifiers are safe to embed in a mobile app.
# Never add a Google OAuth client secret to an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# RevenueCat Public API Key (Google Play)
# Once you set up your RevenueCat account and Google Play project, paste your public key here (e.g. goog_abcdef123456).
# If empty, the app runs gracefully in local sandbox/dev mode.
# EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY=test_OvIsZkGFMQuXFOrDOdgJBNwtxyo
EXPO_PUBLIC_REVENUECAT_GOOGLE_API_KEY

# Google AdMob Configuration
# App ID (format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX)
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX

# Banner Ad Unit IDs (format: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX)
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
